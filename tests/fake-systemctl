#!/bin/sh
set -eu
log=$AXS_RUN/systemctl.log
printf '%s\n' "$*" >>"$log"
if [ "${1:-}" = "--user" ]; then
    if [ $# -gt 0 ]; then
        shift
    fi
fi
cmd=${1:-}
if [ $# -gt 0 ]; then
    shift
fi
case $cmd in
    is-active)
        if [ -f "$AXS_RUN/systemctl.active" ]; then
            exit 0
        fi
        exit 3
        ;;
    show)
        prop=
        while [ $# -gt 0 ]; do
            case $1 in
                -p)
                    prop=$2
                    shift
                    shift
                    ;;
                --value) shift ;;
                *) shift ;;
            esac
        done
        if [ "$prop" = "MainPID" ]; then
            printf '%s\n' 4242
        fi
        ;;
    list-timers)
        printf '%s\n' "Tue 2026-10-21 02:00:00 CST"
        ;;
    start|stop|restart)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
