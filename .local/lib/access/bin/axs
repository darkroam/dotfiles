#!/bin/sh
set -eu
BIN=$0
if [ -L "$BIN" ]; then
    dest=$(readlink "$BIN")
    case $dest in
        /*) BIN=$dest ;;
        *) BIN=$(cd "$(dirname "$BIN")" && pwd)/$dest ;;
    esac
fi
ROOT=$(cd "$(dirname "$BIN")/.." && pwd)
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m axs "$@"
