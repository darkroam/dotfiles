[Unit]
Description=axs mihomo
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %h/.local/lib/access/run
# PID 由 mihomo-run 写入。不要在这里写进程号，systemd 会先展开。
ExecStart=%h/.local/lib/access/bin/mihomo-run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
