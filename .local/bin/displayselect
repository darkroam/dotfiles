#!/bin/sh

# A UI for detecting and selecting all displays. Probes xrandr for connected
# displays and lets user select one to use. User may also select "manual
# selection" which opens arandr.

missing_command() {
    message="displayselect requires $1. Install it before using this feature."
    printf '%s\n' "$message" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Display configuration unavailable" "$message"
    fi
}

needs_xrandr=1
case "${1:-}" in
    --list|--delete) needs_xrandr=0 ;;
esac
if [ "$needs_xrandr" -eq 1 ] && ! command -v xrandr >/dev/null 2>&1; then
    missing_command xrandr
    exit 127
fi

if ! command -v flock >/dev/null 2>&1; then
    missing_command flock
    exit 127
fi

user_id=${UID:-$(id -u)}
case "$user_id" in
    ''|*[!0-9]*)
        printf 'displayselect cannot determine a valid numeric user ID.\n' >&2
        exit 1
        ;;
esac

runtime_dir=
if [ -n "${XDG_RUNTIME_DIR:-}" ] &&
    [ -d "$XDG_RUNTIME_DIR" ] &&
    [ ! -L "$XDG_RUNTIME_DIR" ] &&
    [ -w "$XDG_RUNTIME_DIR" ] &&
    [ -x "$XDG_RUNTIME_DIR" ] &&
    [ "$(stat -c '%u' "$XDG_RUNTIME_DIR" 2>/dev/null)" = "$user_id" ] &&
    [ "$(stat -c '%a' "$XDG_RUNTIME_DIR" 2>/dev/null)" = 700 ]; then
    runtime_dir=$XDG_RUNTIME_DIR
else
    runtime_base=${TMPDIR:-/tmp}
    case "$runtime_base" in
        /*) ;;
        *) runtime_base=/tmp ;;
    esac
    if [ ! -d "$runtime_base" ] ||
        [ ! -w "$runtime_base" ] ||
        [ ! -x "$runtime_base" ]; then
        runtime_base=/tmp
    fi
    if [ ! -d "$runtime_base" ] ||
        [ ! -w "$runtime_base" ] ||
        [ ! -x "$runtime_base" ]; then
        printf 'displayselect cannot find a usable runtime directory.\n' >&2
        exit 1
    fi

    runtime_dir=$runtime_base/xdisplay-$user_id
    if [ -L "$runtime_dir" ]; then
        printf 'displayselect refuses a symlinked runtime directory.\n' >&2
        exit 1
    fi
    if ! (umask 077 && mkdir -p "$runtime_dir"); then
        printf 'displayselect cannot create a private runtime directory.\n' >&2
        exit 1
    fi
    if [ -L "$runtime_dir" ] || [ ! -d "$runtime_dir" ]; then
        printf 'displayselect refuses an unsafe runtime directory.\n' >&2
        exit 1
    fi
    if [ "$(stat -c '%u' "$runtime_dir" 2>/dev/null)" != "$user_id" ]; then
        printf 'displayselect runtime directory has the wrong owner.\n' >&2
        exit 1
    fi

    if [ "$(stat -c '%a' "$runtime_dir" 2>/dev/null)" != 700 ]; then
        chmod 700 "$runtime_dir" 2>/dev/null || {
            printf 'displayselect cannot secure its private runtime directory.\n' >&2
            exit 1
        }
    fi
    if [ "$(stat -c '%u:%a' "$runtime_dir" 2>/dev/null)" != "$user_id:700" ]; then
        printf 'displayselect private runtime directory validation failed.\n' >&2
        exit 1
    fi
fi

display_server=${DISPLAY:-}
[ -n "$display_server" ] || display_server=unknown

case "$display_server" in
    *:*)
        display_tail=${display_server##*:}
        case "$display_tail" in
            *.*)
                display_number=${display_tail%.*}
                screen_number=${display_tail##*.}
                case "$display_number" in
                    ''|*[!0-9]*) ;;
                    *)
                        case "$screen_number" in
                            ''|*[!0-9]*) ;;
                            *) display_server=${display_server%:*}:$display_number ;;
                        esac
                        ;;
                esac
                ;;
        esac
        ;;
esac
display_key=$(printf '%s' "$display_server" |
    LC_ALL=C tr -c 'A-Za-z0-9_-' '_')
[ -n "$display_key" ] || display_key=unknown
lock_prefix=$runtime_dir/xdisplay-$user_id-$display_key

exec 8>"$lock_prefix.apply.lock"
if ! flock -w 30 8; then
    message="Another display configuration is still in progress."
    printf '%s\n' "$message" >&2
    command -v notify-send >/dev/null 2>&1 &&
        notify-send "Display configuration unavailable" "$message"
    exit 75
fi

twoscreen() { # If multi-monitor is selected and there are two screens.

    mirror=$(printf "no\nyes" | dmenu -i -p "Mirror displays?") || return 1
    [ -n "$mirror" ] || return 1
    # Mirror displays using native resolution of external display and a scaled
    # version for the internal display
    if [ "$mirror" = "yes" ]; then
        external=$(echo "$screens" | dmenu -i -p "Optimize resolution for:") || return 1
        [ -n "$external" ] || return 1
        internal=$(printf '%s\n' "$screens" | awk -v output="$external" '$1 != output')

        res_external=$(xrandr --query | sed -n "/^$external/,/\+/p" | \
            tail -n 1 | awk '{print $1}')
        res_internal=$(xrandr --query | sed -n "/^$internal/,/\+/p" | \
            tail -n 1 | awk '{print $1}')

        res_ext_x=$(echo "$res_external" | sed 's/x.*//')
        res_ext_y=$(echo "$res_external" | sed 's/.*x//')
        res_int_x=$(echo "$res_internal" | sed 's/x.*//')
        res_int_y=$(echo "$res_internal" | sed 's/.*x//')

        scale_x=$(echo "$res_ext_x / $res_int_x" | bc -l)
        scale_y=$(echo "$res_ext_y / $res_int_y" | bc -l)

        xrandr --output "$external" --auto --scale 1.0x1.0 \
            --output "$internal" --auto --same-as "$external" \
            --scale "$scale_x"x"$scale_y"
    else

        primary=$(echo "$screens" | dmenu -i -p "Select primary display:") || return 1
        [ -n "$primary" ] || return 1
        secondary=$(printf '%s\n' "$screens" | awk -v output="$primary" '$1 != output')
        direction=$(printf "left\nright" | dmenu -i -p "What side of $primary should $secondary be on?") || return 1
        [ -n "$direction" ] || return 1
        xrandr --output "$primary" --primary --auto --scale 1.0x1.0 \
            --output "$secondary" --"$direction"-of "$primary" --auto --scale 1.0x1.0
    fi
    }

morescreen() { # If multi-monitor is selected and there are more than two screens.
	primary=$(echo "$screens" | dmenu -i -p "Select primary display:") || return 1
	[ -n "$primary" ] || return 1
	secondary=$(printf '%s\n' "$screens" | awk -v output="$primary" '$1 != output' | dmenu -i -p "Select secondary display:") || return 1
	[ -n "$secondary" ] || return 1
	direction=$(printf "left\nright" | dmenu -i -p "What side of $primary should $secondary be on?") || return 1
	[ -n "$direction" ] || return 1
	tertiary=$(printf '%s\n' "$screens" | awk -v first="$primary" -v second="$secondary" '$1 != first && $1 != second' | dmenu -i -p "Select third display:") || return 1
	[ -n "$tertiary" ] || return 1
	xrandr --output "$primary" --primary --auto --output "$secondary" --"$direction"-of "$primary" --auto --output "$tertiary" --"$(printf "left\nright" | grep -v "$direction")"-of "$primary" --auto
	}

multimon() { # Multi-monitor handler.
	case "$(echo "$screens" | wc -l)" in
		2) twoscreen ;;
		*) morescreen ;;
	esac ;}

onescreen() { # If only one output available or chosen.
	xrandr --output "$1" --primary --auto --scale 1.0x1.0 $(printf '%s\n' "$allposs" | awk -v output="$1" '$1 != output {print "--output", $1, "--off"}' | paste -sd ' ' -)
	}

release_layout_lock() {
	flock -u 8
	exec 8>&-
	}

postrun() { # Stuff to run to clean up.
	release_layout_lock
	command -v setbg >/dev/null 2>&1 && setbg
	command -v remaps >/dev/null 2>&1 && remaps
	if command -v dunst >/dev/null 2>&1; then
		{ killall dunst ; setsid -f dunst ;} >/dev/null 2>&1
	fi
	}

custom_layout_dir=${XDISPLAY_CUSTOM_LAYOUT_DIR:-$HOME/.config/x11/display-layouts/custom}

valid_layout_name() {
    case "$1" in
        ''|.*|*[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

custom_lid_state() {
    for lid_file in /proc/acpi/button/lid/*/state; do
        [ -r "$lid_file" ] || continue
        IFS=' ' read -r _ lid_value < "$lid_file"
        case "$lid_value" in open|closed) printf '%s\n' "$lid_value"; return ;; esac
    done
    printf '%s\n' any
}

custom_layout_snapshot() {
    xrandr --query | awk '
        function geometry(value,    rest, pos, sign, dimensions, tail) {
            if (value !~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) return 0
            split(value, dimensions, "x")
            rest=dimensions[2]; pos=match(rest, /[+-]/)
            if (!pos) return 0
            w=dimensions[1]; h=substr(rest, 1, pos-1); tail=substr(rest,pos)
            sign=match(substr(tail,2), /[+-]/); if (!sign) return 0
            sign++; x=substr(tail,1,sign-1); y=substr(tail,sign); return 1
        }
        function flush(    i, token) {
            if (!name || !active || !have_geometry) return
            printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, x+0, y+0, mode, rate, primary
        }
        /^[^ \t]/ {
            flush()
            name=""; active=0; have_geometry=0; primary=0; mode="-"; rate="-"; x=0; y=0
            if ($2 == "connected") {
                name=$1; active=1
                for (i=3; i<=NF; i++) {
                    if ($i == "primary") primary=1
                    if (geometry($i)) have_geometry=1
                }
                if (primary) primary_name=name
            }
            next
        }
        active && $1 ~ /^[0-9]+x[0-9]+$/ {
            if (mode != "-") next
            mode=$1
            for (i=2; i<=NF; i++) {
                token=$i
                if (token ~ /[*]/) {
                    gsub(/[+*]/, "", token)
                    rate=token
                    break
                }
            }
            next
        }
        END { flush() }
    '
}

save_custom_layout() {
    requested=${1:-}
    if [ -z "$requested" ]; then
        requested=$(date '+auto-%Y-%m-%d-%H-%M-%S')
    fi
    valid_layout_name "$requested" || {
        printf 'displayselect: invalid layout name: %s\n' "$requested" >&2
        return 2
    }
    snapshot=$(custom_layout_snapshot) || {
        printf 'displayselect: cannot read current display layout.\n' >&2
        return 1
    }
    [ -n "$snapshot" ] || {
        printf 'displayselect: no active outputs to save.\n' >&2
        return 1
    }
    saved_lid=$(custom_lid_state)
    if [ "$saved_lid" = closed ]; then
        snapshot=$(printf '%s\n' "$snapshot" | awk -F '\t' -v legacy="${XDISPLAY_INTERNAL_OUTPUTS:-}" '
            BEGIN { split(legacy, names, /[[:space:]]+/) }
            $1 ~ /^(eDP|LVDS|DSI)-?[0-9]+$/ { next }
            { for (i in names) if ($1 == names[i]) next }
            { print }
        ')
    fi
    [ -n "$snapshot" ] || {
        printf 'displayselect: no active external outputs to save while closed.\n' >&2
        return 1
    }
    old_umask=$(umask)
    umask 077
    mkdir -p "$custom_layout_dir" || { umask "$old_umask"; return 1; }
    chmod 700 "$custom_layout_dir" 2>/dev/null || :
    target=$custom_layout_dir/$requested.conf
    temp=$target.tmp.$$
    primary=$(printf '%s\n' "$snapshot" | awk -F '\t' '$6 == 1 { print $1; exit }')
    [ -n "$primary" ] || primary=$(printf '%s\n' "$snapshot" | awk -F '\t' 'NR == 1 { print $1 }')
    outputs=$(printf '%s\n' "$snapshot" | awk -F '\t' '{ if (NR > 1) printf ","; printf "%s", $1 }')
    {
        printf '[identity]\noutputs = %s\nlid = %s\nmatch_mode = exact\n\n' \
            "$outputs" "$saved_lid"
        printf '[layout]\nprimary = %s\norder = %s\n' "$primary" "$outputs"
        printf '%s\n' "$snapshot" | awk -F '\t' '{ printf "output_%d = %s|%s|%s|%s|%s\n", NR, $1, $2, $3, $4, $5 }'
    } > "$temp" || { rm -f "$temp"; umask "$old_umask"; return 1; }
    chmod 600 "$temp" 2>/dev/null || :
    mv -f "$temp" "$target" || { rm -f "$temp"; umask "$old_umask"; return 1; }
    chmod 600 "$target" 2>/dev/null || :
    umask "$old_umask"
    printf '%s\n' "$target"
}

list_custom_layouts() {
    [ -d "$custom_layout_dir" ] || return 0
    for layout_file in "$custom_layout_dir"/*.conf; do
        [ -f "$layout_file" ] || continue
        basename=${layout_file##*/}; basename=${basename%.conf}
        printf '%s\n' "$basename"
    done
}

delete_custom_layout() {
    name=$1
    valid_layout_name "$name" || return 2
    target=$custom_layout_dir/$name.conf
    [ -f "$target" ] || {
        printf 'displayselect: layout not found: %s\n' "$name" >&2
        return 1
    }
    rm -f "$target"
}

case "${1:-}" in
    --save)
        [ "$#" -le 2 ] || { printf 'displayselect: --save accepts at most one name.\n' >&2; exit 2; }
        save_custom_layout "${2:-}"
        exit $?
        ;;
    --list)
        [ "$#" -eq 1 ] || { printf 'displayselect: --list takes no arguments.\n' >&2; exit 2; }
        list_custom_layouts
        exit 0
        ;;
    --delete)
        [ "$#" -eq 2 ] || { printf 'displayselect: --delete requires a name.\n' >&2; exit 2; }
        delete_custom_layout "$2"
        exit $?
        ;;
esac

# Get all possible displays
allposs=$(xrandr -q | awk '$2 == "connected" || $2 == "disconnected"')

# Get all connected screens.
screens=$(printf '%s\n' "$allposs" | awk '$2 == "connected" {print $1}')
screen_count=$(printf '%s\n' "$screens" |
	awk 'NF { count++ } END { print count + 0 }')

case "$screen_count" in
	0)
		message="No connected displays were detected."
		printf '%s\n' "$message" >&2
		command -v notify-send >/dev/null 2>&1 &&
			notify-send "Display configuration unavailable" "$message"
		release_layout_lock
		exit 1
		;;
	1)
		onescreen "$screens" || {
			result=$?
			release_layout_lock
			exit "$result"
		}
		postrun
		command -v notify-send >/dev/null 2>&1 &&
			notify-send "💻 Only one screen detected." "Using it in its optimal settings..."
		exit
		;;
esac

# Get user choice including multi-monitor and manual selection:
if ! chosen=$(printf "%s\\nmulti-monitor\\nmanual selection" "$screens" |
	dmenu -i -p "Select display arangement:") || [ -z "$chosen" ]; then
	release_layout_lock
	exit 1
fi

case "$chosen" in
	"manual selection")
		if ! command -v arandr >/dev/null 2>&1; then
			missing_command arandr
			exit 127
		fi
		arandr
		release_layout_lock
		exit
		;;
	"multi-monitor") multimon ;;
	*) onescreen "$chosen" ;;
esac || {
	result=$?
	release_layout_lock
	exit "$result"
}

postrun
