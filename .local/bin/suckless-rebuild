#!/bin/sh
# Build the four suckless trees. Never pulls, resets, or kills processes.

set -eu

src_root=${SUCKLESS_SRC:-$HOME/src}
prefix_bin=${SUCKLESS_PREFIX_BIN:-/usr/local/bin}
origin=${SUCKLESS_ORIGIN:-git@github.com:darkroam}
proc_root=${SUCKLESS_PROC:-/proc}

usage() {
	printf '用法：suckless-rebuild [st|dmenu|dwm|dwmblocks]\n' >&2
	exit 2
}

is_name() {
	case $1 in
		st|dmenu|dwm|dwmblocks) return 0 ;;
		*) return 1 ;;
	esac
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || {
		printf '缺少命令：%s\n' "$1" >&2
		exit 1
	}
}

file_sha() {
	sum=$(sha256sum -- "$1") || return 1
	printf '%s\n' "${sum%% *}"
}

run_logged() {
	log=$1
	shift
	if "$@" >"$log" 2>&1; then
		return 0
	fi
	keep_logs=1
	printf '  命令失败，最近输出：\n' >&2
	tail -n 30 "$log" >&2 || true
	printf '  完整日志：%s\n' "$log" >&2
	return 1
}

check_build_deps() {
	need_cmd make
	need_cmd gcc
	need_cmd pkg-config
	if ! pkg-config --exists x11 fontconfig freetype2; then
		printf '缺少开发库：x11、fontconfig 或 freetype2\n' >&2
		exit 1
	fi
	need_st=0
	for name in "$@"; do
		[ "$name" = st ] && need_st=1
	done
	if [ "$need_st" -eq 1 ]; then
		need_cmd tic
	fi
}

check_terminfo() {
	if ! command -v infocmp >/dev/null 2>&1 || ! infocmp -q st-256color >/dev/null 2>&1; then
		printf 'terminfo 风险：缺少 st-256color\n' >&2
	fi
}

report_old() {
	name=$1
	prod=$2
	if ! command -v pgrep >/dev/null 2>&1; then
		printf '缺少命令：pgrep，跳过进程检查\n' >&2
		return 0
	fi
	pids=$(pgrep -x "$name" || true)
	[ -n "$pids" ] || return 0
	new_sha=$(file_sha "$prod")
	for pid in $pids; do
		exe=$(readlink "$proc_root/$pid/exe" 2>/dev/null || true)
		stale=0
		case $exe in
			*" (deleted)") stale=1 ;;
			*)
				if [ -n "$exe" ] && [ -f "$exe" ]; then
					old_sha=$(file_sha "$exe")
					[ "$old_sha" = "$new_sha" ] || stale=1
				fi
				;;
		esac
		if [ "$stale" -eq 1 ]; then
			printf '旧进程仍在运行：%s pid %s（不结束进程）\n' "$name" "$pid" >&2
		fi
	done
}


sync_one() {
	name=$1
	dir=$src_root/$name
	if [ ! -e "$dir" ]; then
		if ! run_logged "$logdir/$name-clone.log" git clone "$origin/$name.git" "$dir"; then
			printf 'clone 失败：%s\n' "$name" >&2
			return 1
		fi
		printf '  源码已 clone\n'
	elif [ ! -d "$dir" ] || ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
		printf '不是 git 仓库：%s\n' "$dir" >&2
		return 1
	fi
	if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null || true)" ]; then
		printf '本地修改：%s\n' "$name" >&2
	fi
	if ! make -C "$dir"; then
		printf '构建失败：%s\n' "$name" >&2
		return 1
	fi
	printf '  构建完成\n'
	prod=$dir/$name
	if [ ! -f "$prod" ]; then
		printf '没有产物：%s\n' "$prod" >&2
		return 1
	fi
	inst=$prefix_bin/$name
	status=unknown
	if [ -f "$inst" ] && [ "$(file_sha "$prod")" = "$(file_sha "$inst")" ]; then
		printf '  跳过安装（已是最新）\n'
		status=已是最新
		if [ "$name" = st ]; then
			check_terminfo
		fi
	else
		if [ ! -t 0 ] || [ ! -t 1 ]; then
			printf '需要终端才能安装：%s\n' "$name" >&2
			return 1
		fi
		if ! run_logged "$logdir/$name-install.log" sudo -k make -C "$dir" install; then
			printf '安装失败：%s\n' "$name" >&2
			return 1
		fi
		if [ ! -f "$inst" ] || [ "$(file_sha "$prod")" != "$(file_sha "$inst")" ]; then
			printf '安装后 SHA 不一致：%s\n' "$name" >&2
			return 1
		fi
		printf '  已安装\n'
		status=已安装
	fi
	report_old "$name" "$prod"
	printf '%s\t%s\n' "$name" "$status" >> "$results"
	return 0
}

if [ "$#" -gt 1 ]; then
	usage
fi
if [ "$#" -eq 0 ]; then
	set -- st dmenu dwm dwmblocks
elif ! is_name "$1"; then
	usage
fi

check_build_deps "$@"
logdir=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/suckless-rebuild.XXXXXX") || {
	printf '无法创建日志目录\n' >&2
	exit 1
}
keep_logs=0
trap 'if [ "$keep_logs" -eq 0 ]; then rm -rf "$logdir"; else printf "日志保留：%s\n" "$logdir" >&2; fi' EXIT
results=$logdir/results
: > "$results"
fail=0
printf 'suckless-rebuild：%s\n' "$*"
for name in "$@"; do
	printf '\n==> %s\n' "$name"
	if ! sync_one "$name"; then
		printf '%s\t失败\n' "$name" >> "$results"
		fail=1
	fi
done
printf '\n结果：\n'
while IFS="$(printf '\t')" read -r name status; do
	printf '  %-10s %s\n' "$name" "$status"
done < "$results"
exit "$fail"
