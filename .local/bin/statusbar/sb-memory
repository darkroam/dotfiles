#!/bin/sh

case $BLOCK_BUTTON in
	1) notify-send "🧠 Memory hogs" "$(ps axch -o cmd:15,%mem --sort=-%mem | head)" ;;
	2) setsid -f "$TERMINAL" -e htop ;;
	3) notify-send "🧠 Memory module" "\- 10 cells: █ used, ▓ cache, ░ free.
- Click to show memory hogs.
- Middle click to open htop." ;;
	6) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

free --mebi | awk '
	NR != 2 { next }
	{
		u = $3 + 0; c = $6 + 0; f = $4 + 0; n = 10
		t = u + c + f
		if (t <= 0) { printf "░░░░░░░░░░\n"; exit }
		v[1] = u; v[2] = c; v[3] = f
		sum = 0
		for (i = 1; i <= 3; i++) {
			base[i] = int(v[i] * n / t)
			rem[i] = v[i] * n - base[i] * t
			sum += base[i]
		}
		left = n - sum
		while (left > 0) {
			best = 1
			for (i = 2; i <= 3; i++)
				if (rem[i] > rem[best]) best = i
			base[best]++
			rem[best] = -1
			left--
		}
		g[1] = "█"; g[2] = "▓"; g[3] = "░"
		for (i = 1; i <= 3; i++)
			for (j = 0; j < base[i]; j++) printf "%s", g[i]
		printf "\n"
	}
'
