#!/bin/sh

# This script is called on startup to remap keys.
# Decrease key repeat delay to 300ms and increase key repeat rate to 50 per second.
xset r rate 300 50
# Map the caps lock key to left control, and map the menu key to right super.
setxkbmap -option '' -option ctrl:nocaps,altwin:menu_win
# When caps lock is pressed only once, treat it as escape. Match its physical
# X11 keycode so tapping the real left control key remains unchanged.
killall -w xcape 2>/dev/null ; xcape -e '#66=Escape'
# Turn off caps lock if on since there is no longer a key for it.
if xset -q | grep -q "Caps Lock:\s*on"; then
	xdotool key Caps_Lock
fi
