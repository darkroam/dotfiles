#!/bin/sh

# $1 is a url; $2 is a command
[ -z "$1" ] && exit 1

ifinstalled tsp || exit 1

url="$1"
if [ -n "$2" ]; then
	set -- $2 "$url"
else
	ifinstalled yt-dlp || exit 1
	set -- yt-dlp --embed-metadata -ic "$url"
fi

base="$(basename "$url")"
notify-send "⏳ Queuing $base..."
idnum="$(tsp "$@")" || exit 1
[ -n "$idnum" ] || exit 1
realname="$(printf '%s\n' "$base" | sed "s/?\(source\|dest\).*//;s/%20/ /g")"
tsp -D "$idnum" mv "$base" "$realname"
tsp -D "$idnum" notify-send "👍 $realname done."
