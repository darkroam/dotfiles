#!/usr/bin/env bash
# dotcfg - Unified CLI for dotfiles state management
# Usage: dotcfg <subcommand> [options]
#
# Subcommands:
#   status              Show current state and available transitions (default)
#   graph               Show state graph with current position
#   history             Show transition history from backup manifests
#   switch <target>     Transition to target state (fresh|full|min|macos)
#   validate            Show detailed repository validation
#   help                Show this help message
#   version             Show version

set -euo pipefail

DOTCFG_VERSION="2.0.0"
GIT_DIR="${DOTCFG_GIT_DIR:-$HOME/.cfg}"
BACKUP_ROOT="$HOME/.config-backup"
BIN_DIR="${DOTCFG_BIN_DIR:-$HOME/.local/bin}"

DOTFILES_LIB_DIR="${DOTFILES_LIB_DIR:-$HOME/.local/lib/dotfiles}"

# ── Bootstrap installation (self-contained, no library dependencies) ───

_bootstrap_install() {
    printf 'dotcfg: library not found, starting bootstrap installation...\n'

    local is_ours=false
    local remote_url=""
    if [ -d "$GIT_DIR" ]; then
        if git --git-dir="$GIT_DIR" rev-parse --git-dir >/dev/null 2>&1; then
            remote_url=$(git --git-dir="$GIT_DIR" remote get-url origin 2>/dev/null) || remote_url=""
            case "$remote_url" in
                git@github.com:darkroam/dotfiles.git*|https://github.com/darkroam/dotfiles.git*)
                    is_ours=true ;;
            esac
            if ! $is_ours && git --git-dir="$GIT_DIR" cat-file -e HEAD:.local/bin/dotcfg 2>/dev/null; then
                is_ours=true
            fi
            if $is_ours; then
                printf 'Repository exists at %s. Restoring library from HEAD...\n' "$GIT_DIR"
            else
                printf 'Warning: %s exists but is not a valid dotfiles repository.\n' "$GIT_DIR" >&2
                printf 'Please remove it manually and rerun installation:\n' >&2
                printf '  rm -rf %s\n' "$GIT_DIR" >&2
                exit 1
            fi
        else
            printf 'Warning: %s exists but is not a valid git repository.\n' "$GIT_DIR" >&2
            printf 'Please remove it manually and rerun installation:\n' >&2
            printf '  rm -rf %s\n' "$GIT_DIR" >&2
            exit 1
        fi
    else
        remote_url="${DOTCFG_REMOTE_URL:-git@github.com:darkroam/dotfiles.git}"
        printf 'Cloning dotfiles repository from %s...\n' "$remote_url"
        if ! git clone --bare --quiet "$remote_url" "$GIT_DIR"; then
            printf 'ERROR: failed to clone repository\n' >&2
            exit 1
        fi
    fi

    # Extract library files from HEAD into $DOTFILES_LIB_DIR
    mkdir -p "$DOTFILES_LIB_DIR/utils" "$DOTFILES_LIB_DIR/commands"
    local p rel
    while IFS= read -r p; do
        case "$p" in
            .local/lib/dotfiles/cfg-validate.sh|.local/lib/dotfiles/utils/*|.local/lib/dotfiles/commands/*|.local/lib/dotfiles/categories*.conf|.local/lib/dotfiles/exclude.conf)
                rel="${p#.local/lib/dotfiles/}"
                git --git-dir="$GIT_DIR" show "HEAD:$p" > "$DOTFILES_LIB_DIR/$rel"
                ;;
        esac
    done < <(git --git-dir="$GIT_DIR" ls-tree -r --name-only HEAD)

    # Install dotcfg itself
    if ! mkdir -p -- "$BIN_DIR"; then
        printf 'ERROR: failed to create command directory: %s\n' "$BIN_DIR" >&2
        exit 1
    fi

    local dotcfg_tmp="$BIN_DIR/dotcfg.tmp"
    if ! git --git-dir="$GIT_DIR" show "HEAD:.local/bin/dotcfg" > "$dotcfg_tmp" 2>/dev/null; then
        rm -f -- "$dotcfg_tmp"
        printf 'ERROR: repository does not contain the dotcfg command\n' >&2
        exit 1
    fi
    if ! chmod +x "$dotcfg_tmp" || ! mv -- "$dotcfg_tmp" "$BIN_DIR/dotcfg"; then
        rm -f -- "$dotcfg_tmp"
        printf 'ERROR: failed to install dotcfg in %s\n' "$BIN_DIR" >&2
        exit 1
    fi

    if [ ! -f "$DOTFILES_LIB_DIR/cfg-validate.sh" ]; then
        printf 'ERROR: repository does not contain the dotfiles library\n' >&2
        exit 1
    fi

    . "$DOTFILES_LIB_DIR/cfg-validate.sh"
    export GIT_DIR BACKUP_ROOT DOTFILES_LIB_DIR
    . "$DOTFILES_LIB_DIR/commands/bootstrap-lib.sh"
    if ! bootstrap_finish_install; then
        printf 'ERROR: bootstrap installation failed\n' >&2
        exit 1
    fi

    if [ $# -gt 0 ]; then
        exec bash "$BIN_DIR/dotcfg" "$@"
    fi
    exit 0
}

if [ -f "$DOTFILES_LIB_DIR/cfg-validate.sh" ]; then
    . "$DOTFILES_LIB_DIR/cfg-validate.sh"
else
    _bootstrap_install "$@"
fi

_dotcfg_load_business_libraries() {
	if [ -n "${_DOTCFG_BUSINESS_LOADED:-}" ]; then
		return 0
	fi

	if [ -f "$DOTFILES_LIB_DIR/utils/nodes.sh" ]; then
		. "$DOTFILES_LIB_DIR/utils/nodes.sh"
	fi
	if [ -f "$DOTFILES_LIB_DIR/utils/categories.sh" ]; then
		. "$DOTFILES_LIB_DIR/utils/categories.sh"
	fi
	if [ -f "$DOTFILES_LIB_DIR/utils/exclude.sh" ]; then
		. "$DOTFILES_LIB_DIR/utils/exclude.sh"
	fi
	if [ -f "$DOTFILES_LIB_DIR/utils/fresh.sh" ]; then
		. "$DOTFILES_LIB_DIR/utils/fresh.sh"
	fi

	_DOTCFG_BUSINESS_LOADED=1
}

# ── Helpers ─────────────────────────────────────────────────────────────

_print_transitions_from() {
    local state="$1"
    case "$state" in
        fresh)
            printf '  -> full       (install all managed configuration)\n'
            printf '  -> min        (install command-line configuration)\n'
            printf '  -> macos      (install cross-platform core configuration)\n'
            ;;
        full|min|macos)
            [ "$state" = "full" ] || printf '  -> full       (install all managed configuration)\n'
            [ "$state" = "min" ] || printf '  -> min        (install command-line configuration)\n'
            [ "$state" = "macos" ] || printf '  -> macos      (install cross-platform core configuration)\n'
            printf '  -> fresh      (uninstall all dotfiles)\n'
            ;;
    esac
}

_transition_script_for() {
    local current="$1" target="$2"
    local cmd_dir="$DOTFILES_LIB_DIR/commands"
    case "$target" in
        full|min|macos) printf '%s' "$cmd_dir/switch.sh" ;;
        fresh) printf '%s' "$cmd_dir/uninstall.sh" ;;
        *) return 1 ;;
    esac
}

_transition_description() {
    local current="$1" target="$2"
    case "$target" in
        full)  printf 'Install all managed configuration' ;;
        min)   printf 'Install command-line configuration' ;;
        macos) printf 'Install cross-platform core configuration' ;;
        fresh) printf 'Uninstall managed configuration and restore the Fresh backup' ;;
    esac
}

# ── Subcommands ─────────────────────────────────────────────────────────

cmd_status() {
    cfg_validate "$GIT_DIR"
    cfg_print_validation_result "$GIT_DIR"

    local current_state
    current_state=$(cfg_detect_state "$GIT_DIR")

    cfg_nodes_init "$BACKUP_ROOT"

    local head_code=""
    head_code=$(cfg_head_get 2>/dev/null) || true

    if [ -n "$head_code" ] && cfg_nodes_read_index 2>/dev/null; then
        local i node_type="" node_ts=""
        for ((i = 0; i < ${#_CFG_NODE_CODES[@]}; i++)); do
            if [ "${_CFG_NODE_CODES[$i]}" = "$head_code" ]; then
                node_type="${_CFG_NODE_TYPES[$i]}"
                node_ts="${_CFG_NODE_TIMESTAMPS[$i]}"
                break
            fi
        done

        local deploy_status
        deploy_status=$(cfg_deploy_status_get)

        printf '\nCurrent node: %s (%s)\n' "$head_code" "${node_type:-unknown}"
        if [ -n "$node_ts" ]; then
            printf 'Created: %s\n' "$node_ts"
        fi
        printf 'Deploy status: %s\n' "$deploy_status"

        local node_version node_status
        node_version=$(cfg_node_get "$head_code" "config_version" 2>/dev/null) || node_version=""
        node_status=$(cfg_node_get "$head_code" "status" 2>/dev/null) || node_status="active"
        if [ -n "$node_version" ] && [ "$node_version" != "unknown" ]; then
            printf 'Config version: %s\n' "$node_version"
        fi
        printf 'Node status: %s\n' "$node_status"

        local ancestors
        ancestors=$(cfg_nodes_ancestors "$head_code" 2>/dev/null) || true
        if [ -n "$ancestors" ]; then
            local chain=""
            local first=true
            while IFS= read -r code; do
                [ -z "$code" ] && continue
                local atype=""
                for ((i = 0; i < ${#_CFG_NODE_CODES[@]}; i++)); do
                    if [ "${_CFG_NODE_CODES[$i]}" = "$code" ]; then
                        atype="${_CFG_NODE_TYPES[$i]}"
                        break
                    fi
                done
                if $first; then
                    chain="$atype"
                    first=false
                else
                    chain="$atype -> $chain"
                fi
            done <<< "$ancestors"
            printf 'Chain: %s\n' "$chain"
        fi
    else
        printf '\nCurrent state: %s\n' "$current_state"
        printf 'No nodes found. Run "dotcfg switch full", "dotcfg switch min", or "dotcfg switch macos".\n'
    fi

    printf '\nAvailable operations:\n'
    printf '  dotcfg switch full       Install all managed configuration\n'
    printf '  dotcfg switch min        Install command-line configuration\n'
    printf '  dotcfg switch macos      Install cross-platform core configuration\n'
    printf '  dotcfg deploy            Deploy current node\n'
    printf '  dotcfg undeploy          Undeploy current node\n'
    printf '  dotcfg uninstall         Return to fresh state\n'
    printf '  dotcfg list              List all nodes\n'
    printf '  dotcfg history           Show node tree\n'
}

cmd_list() {
    cfg_nodes_init "$BACKUP_ROOT"

    if ! cfg_nodes_read_index 2>/dev/null || [ ${#_CFG_NODE_CODES[@]} -eq 0 ]; then
        printf 'No nodes found.\n'
        printf 'Run "dotcfg switch full", "dotcfg switch min", or "dotcfg switch macos" to create nodes.\n'
        return
    fi

    local head_code
    head_code=$(cfg_head_get 2>/dev/null) || true
    local deploy_status
    deploy_status=$(cfg_deploy_status_get)

    printf '  %-6s %-10s %-8s %-10s %-20s %s\n' "DEPLOY" "TYPE" "VERSION" "STATUS" "TIME" "CODE"

    local i
    for ((i = ${#_CFG_NODE_CODES[@]} - 1; i >= 0; i--)); do
        local code="${_CFG_NODE_CODES[$i]}"
        local type="${_CFG_NODE_TYPES[$i]}"
        local ts="${_CFG_NODE_TIMESTAMPS[$i]}"
        local display_ts
        display_ts=$(printf '%s' "$ts" | sed 's/T/ /;s/\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\) \([0-9]\{2\}\):\([0-9]\{2\}\):\([0-9]\{2\}\)/\1 \2:\3:\4/')

        local marker="[ ]"
        if [ "$code" = "$head_code" ] && [ "$deploy_status" = "deployed" ]; then
            marker="[*]"
        elif [ "$code" = "$head_code" ]; then
            marker="[>]"
        fi

        local node_status="${_CFG_NODE_STATUSES[$i]:-active}"
        local display_status="$node_status"
        [ "$node_status" = "marked_for_removal" ] && display_status="[REMOVED]"

        local node_version="${_CFG_NODE_CONFIG_VERSIONS[$i]:-}"
        [ -z "$node_version" ] && node_version="-"

        local root_mark=""
        if [ "$type" = "fresh" ]; then
            root_mark=" ●"
        fi

        printf '  %-6s %-10s %-8s %-10s %-20s %s%s\n' "$marker" "$type" "$node_version" "$display_status" "$display_ts" "$code" "$root_mark"
    done
}

cmd_history() {
    cfg_nodes_init "$BACKUP_ROOT"

    if ! cfg_nodes_read_index 2>/dev/null || [ ${#_CFG_NODE_CODES[@]} -eq 0 ]; then
        printf 'No history found.\n'
        return
    fi

    local head_code=""
    head_code=$(cfg_head_get 2>/dev/null) || true
    local deploy_status
    deploy_status=$(cfg_deploy_status_get)

    _history_init_colors

    local -a main_line=()
    _history_compute_main_line main_line

    local -A on_main_line=()
    local c
    for c in "${main_line[@]}"; do on_main_line["$c"]=1; done

    local -a disp_codes=() disp_lanes=() disp_types=()
    _history_build_display main_line on_main_line disp_codes disp_lanes disp_types

    _history_render disp_codes disp_lanes disp_types "$head_code" "$deploy_status"
}

_history_init_colors() {
    _C_GREEN="" _C_YELLOW="" _C_GRAY="" _C_BLUE="" _C_RESET=""
    if [ -t 1 ] && tput colors >/dev/null 2>&1; then
        local ncolors
        ncolors=$(tput colors 2>/dev/null) || ncolors=0
        if (( ncolors >= 8 )); then
            _C_GREEN=$'\033[32m'
            _C_YELLOW=$'\033[33m'
            _C_GRAY=$'\033[90m'
            _C_BLUE=$'\033[34m'
            _C_RESET=$'\033[0m'
        fi
    fi
}

_history_compute_main_line() {
    local -n _ml_ref=$1
    local newest_code="" newest_ts=""
    local i
    for ((i = 0; i < ${#_CFG_NODE_CODES[@]}; i++)); do
        local code="${_CFG_NODE_CODES[$i]}"
        local children="${_CFG_NODE_CHILDREN[$i]}"
        local ts="${_CFG_NODE_TIMESTAMPS[$i]}"
        if [ -z "$children" ]; then
            if [ -z "$newest_ts" ] || [[ "$ts" > "$newest_ts" ]]; then
                newest_code="$code"
                newest_ts="$ts"
            fi
        fi
    done

    if [ -z "$newest_code" ]; then
        newest_code=$(cfg_head_get 2>/dev/null) || newest_code="${_CFG_NODE_CODES[${#_CFG_NODE_CODES[@]}-1]}"
    fi

    local -a chain=()
    local current="$newest_code"
    while [ -n "$current" ] && [ "$current" != "null" ]; do
        chain+=("$current")
        current=$(cfg_node_get "$current" "parent" 2>/dev/null) || break
    done

    local j
    for ((j = ${#chain[@]} - 1; j >= 0; j--)); do
        _ml_ref+=("${chain[$j]}")
    done
}

_history_collect_descendants() {
    local root_code="$1"
    local -n _desc_ref=$2
    local -a stack=("$root_code")
    local -a all=()

    while ((${#stack[@]} > 0)); do
        local node="${stack[-1]}"
        unset 'stack[-1]'
        stack=("${stack[@]+"${stack[@]}"}")
        all+=("$node")
        local children
        children=$(cfg_node_get "$node" "children" 2>/dev/null) || true
        if [ -n "$children" ]; then
            IFS=',' read -ra carr <<< "$children"
            local ch
            for ch in "${carr[@]}"; do
                ch="${ch// /}"
                [ -z "$ch" ] && continue
                stack+=("$ch")
            done
        fi
    done

    local -a sorted=()
    local i j
    for ((i = 0; i < ${#all[@]}; i++)); do
        for ((j = i + 1; j < ${#all[@]}; j++)); do
            local ts_i ts_j
            ts_i=$(cfg_node_get "${all[$i]}" "timestamp" 2>/dev/null) || true
            ts_j=$(cfg_node_get "${all[$j]}" "timestamp" 2>/dev/null) || true
            if [[ "$ts_j" > "$ts_i" ]]; then
                local tmp="${all[$i]}"
                all[$i]="${all[$j]}"
                all[$j]="$tmp"
            fi
        done
    done

    for i in "${all[@]}"; do _desc_ref+=("$i"); done
}

_history_build_display() {
    local -n _ml=$1
    local -n _oml=$2
    local -n _dc=$3
    local -n _dl=$4
    local -n _dt=$5

    local main_count=${#_ml[@]}
    local next_side_lane=1
    local mi

    for ((mi = main_count - 1; mi >= 0; mi--)); do
        local code="${_ml[$mi]}"
        _dc+=("$code")
        _dl+=(0)
        _dt+=("node")

        local children
        children=$(cfg_node_get "$code" "children" 2>/dev/null) || true

        local -a side_roots=()
        if [ -n "$children" ]; then
            IFS=',' read -ra carr <<< "$children"
            local ch
            for ch in "${carr[@]}"; do
                ch="${ch// /}"
                [ -z "$ch" ] && continue
                if [ -z "${_oml[$ch]+x}" ]; then
                    side_roots+=("$ch")
                fi
            done
        fi

        local had_side_branches=false

        if ((${#side_roots[@]} > 0)); then
            had_side_branches=true
            local sr
            for sr in "${side_roots[@]}"; do
                _dc+=("__fork__")
                _dl+=(0)
                _dt+=("fork")

                local -a descendants=()
                _history_collect_descendants "$sr" descendants

                local di
                for ((di = 0; di < ${#descendants[@]}; di++)); do
                    _dc+=("${descendants[$di]}")
                    _dl+=(1)
                    _dt+=("node")

                    if ((di < ${#descendants[@]} - 1)); then
                        _dc+=("__connect__")
                        _dl+=(1)
                        _dt+=("side_connect")
                    fi
                done

                _dc+=("__merge__")
                _dl+=(0)
                _dt+=("merge")
            done
        fi

        if ((mi > 0)) && ! $had_side_branches; then
            _dc+=("__connect__")
            _dl+=(0)
            _dt+=("connect")
        fi
    done
}

_history_render() {
    local -n _rc=$1
    local -n _rl=$2
    local -n _rt=$3
    local head_code="$4"
    local deploy_status="$5"

    local count=${#_rc[@]}
    local i

    for ((i = 0; i < count; i++)); do
        local code="${_rc[$i]}"
        local lane="${_rl[$i]}"
        local ltype="${_rt[$i]}"

        case "$ltype" in
            node)
                local type ts display_ts
                type=$(cfg_node_get "$code" "type" 2>/dev/null) || continue
                ts=$(cfg_node_get "$code" "timestamp" 2>/dev/null) || continue
                display_ts="${ts/T/ }"

                local marker="o"
                local head_label=""
                local marker_color=""
                if [ "$code" = "$head_code" ]; then
                    marker="*"
                    marker_color="$_C_GREEN"
                    if [ "$deploy_status" = "deployed" ]; then
                        head_label="  ${_C_GREEN}<- HEAD${_C_RESET}"
                    else
                        head_label="  ${_C_GREEN}<- HEAD${_C_RESET} ${_C_GRAY}[uninstalled]${_C_RESET}"
                    fi
                fi

                local root_tag=""
                if [ "$type" = "fresh" ]; then
                    root_tag=" ${_C_GRAY}[root]${_C_RESET}"
                    if [ "$code" != "$head_code" ]; then
                        marker="●"
                        marker_color="$_C_YELLOW"
                    fi
                fi

                local status_str=""
                if [ "$code" = "$head_code" ]; then
                    if [ "$deploy_status" = "deployed" ]; then
                        status_str=" ${_C_YELLOW}[deployed]${_C_RESET}"
                    fi
                fi

                local version_tag=""
                local ver
                ver=$(cfg_node_get "$code" "config_version" 2>/dev/null) || ver=""
                if [ -n "$ver" ] && [ "$ver" != "unknown" ]; then
                    local version_prefix
                    version_prefix=$(cfg_version_display_prefix "$ver")
                    version_tag=" ${version_prefix}${ver}"
                fi

                local removed_tag=""
                local nstatus
                nstatus=$(cfg_node_get "$code" "status" 2>/dev/null) || nstatus="active"
                if [ "$nstatus" = "marked_for_removal" ]; then
                    removed_tag=" ${_C_YELLOW}[REMOVED]${_C_RESET}"
                fi

                local prefix
                prefix=$(_history_graph_prefix "$lane" "node" "$ltype" "$marker")

                printf '%s%s%s %s  %-7s  %s%s%s%s%s%s\n' \
                    "$_C_BLUE" "$prefix" "$_C_RESET" \
                    "$code" "$type" "$display_ts" "$status_str" "$version_tag" "$removed_tag" "$root_tag" "$head_label"
                ;;
            connect)
                local prefix
                prefix=$(_history_graph_prefix 0 "connect" "$ltype")
                printf '%s%s%s\n' "$_C_BLUE" "$prefix" "$_C_RESET"
                ;;
            fork)
                local prefix
                prefix=$(_history_graph_prefix "$lane" "fork" "$ltype")
                printf '%s%s%s\n' "$_C_BLUE" "$prefix" "$_C_RESET"
                ;;
            merge)
                local prefix
                prefix=$(_history_graph_prefix "$lane" "merge" "$ltype")
                printf '%s%s%s\n' "$_C_BLUE" "$prefix" "$_C_RESET"
                ;;
            side_connect)
                local prefix
                prefix=$(_history_graph_prefix "$lane" "side_connect" "$ltype")
                printf '%s%s%s\n' "$_C_BLUE" "$prefix" "$_C_RESET"
                ;;
        esac
    done
}

_history_graph_prefix() {
    local node_lane="$1"
    local max_lane="$2"
    local line_type="$3"
    local marker="${4:-*}"

    local prefix=""
    local lane

    case "$line_type" in
        node)
            for ((lane = 0; lane < node_lane; lane++)); do
                prefix+="| "
            done
            prefix+="${marker} "
            ;;
        connect)
            for ((lane = 0; lane <= 0; lane++)); do
                prefix+="| "
            done
            ;;
        fork)
            for ((lane = 0; lane < node_lane; lane++)); do
                prefix+="| "
            done
            prefix+="|\\"
            ;;
        merge)
            for ((lane = 0; lane < node_lane; lane++)); do
                prefix+="| "
            done
            prefix+="|/"
            ;;
        side_connect)
            for ((lane = 0; lane <= node_lane; lane++)); do
                prefix+="| "
            done
            ;;
    esac

    printf '%s' "$prefix"
}

cmd_categories() {
    local subcmd="${1:-list}"
    shift || true

    case "$subcmd" in
        list)
            cfg_config_versions_load
            local versions
            versions=$(cfg_config_version_list 2>/dev/null) || true
            if [ -z "$versions" ]; then
                printf 'No config versions found.\n'
                printf 'Using built-in default categories.\n'
                return
            fi
            local current_ver
            current_ver=$(cfg_config_version_get_current 2>/dev/null) || current_ver=""
            [ -z "$current_ver" ] && current_ver=$(cfg_config_version_latest 2>/dev/null) || true

            printf 'Available configuration versions:\n'
            while IFS= read -r ver; do
                [ -z "$ver" ] && continue
                cfg_config_version_read "$ver" >/dev/null 2>&1 || continue
                local cats=()
                local c
                cfg_categories_load "$ver"
                for c in $(cfg_categories_list); do
                    case "$c" in
                        full|empty) continue ;;
                    esac
                    cats+=("$c")
                done
                local tag marker="" tag_gap cats_text display_version
                tag=$(cfg_config_get_tag "$ver" 2>/dev/null) || tag="stable"
                [ "$tag" = "test" ] && marker="   [TEST]"
                [ "$tag" = "experimental" ] && marker="   [EXPERIMENTAL]"
                local vprefix
                vprefix=$(cfg_version_display_prefix "$ver")
                display_version="$vprefix$ver"
                printf -v tag_gap '%*s' "$((9 - ${#tag} > 0 ? 9 - ${#tag} : 1))" ''
                printf -v cats_text '%s, ' "${cats[@]}"
                cats_text="${cats_text%, }"
                printf '  %-7s (%s)%s%d categories: %s%s\n' \
                    "$display_version" "$tag" "$tag_gap" "${#cats[@]}" "$cats_text" "$marker"
            done <<< "$versions"

            local cur_prefix
            cur_prefix=$(cfg_version_display_prefix "$current_ver")
            local current_tag
            if current_tag=$(cfg_config_get_tag "$current_ver" 2>/dev/null); then
                printf '\nCurrent version: %s%s (%s)\n' "$cur_prefix" "$current_ver" "$current_tag"
            else
                printf '\nCurrent version: %s%s\n' "$cur_prefix" "$current_ver"
            fi

            if cfg_nodes_read_index 2>/dev/null && [ ${#_CFG_NODE_CODES[@]} -gt 0 ]; then
                declare -A ver_nodes=()
                local i
                for ((i = 0; i < ${#_CFG_NODE_CODES[@]}; i++)); do
                    local nv="${_CFG_NODE_CONFIG_VERSIONS[$i]:-}"
                    [ -z "$nv" ] || [ "$nv" = "unknown" ] && continue
                    if [ -n "${ver_nodes[$nv]+x}" ]; then
                        ver_nodes[$nv]="${ver_nodes[$nv]} ${_CFG_NODE_CODES[$i]}"
                    else
                        ver_nodes[$nv]="${_CFG_NODE_CODES[$i]}"
                    fi
                done
                if [ ${#ver_nodes[@]} -gt 0 ]; then
                    printf '\nNodes using each version:\n'
                    for ver in $(printf '%s\n' "${!ver_nodes[@]}" | sort); do
                        local nodes_str="${ver_nodes[$ver]}"
                        local -a narr=($nodes_str)
                        local np nodes_text
                        np=$(cfg_version_display_prefix "$ver")
                        printf -v nodes_text '%s, ' "${narr[@]}"
                        nodes_text="${nodes_text%, }"
                        printf '  %s%s: %s (%d node%s)\n' "$np" "$ver" "$nodes_text" \
                            "${#narr[@]}" "$([ ${#narr[@]} -gt 1 ] && printf 's')"
                    done
                fi
            fi
            ;;
        current)
            local current_ver
            current_ver=$(cfg_config_version_get_current 2>/dev/null) || current_ver=""
            if [ -n "$current_ver" ]; then
                local cp
                cp=$(cfg_version_display_prefix "$current_ver")
                local tag
                if tag=$(cfg_config_get_tag "$current_ver" 2>/dev/null); then
                    printf 'Current version: %s%s (%s)\n' "$cp" "$current_ver" "$tag"
                else
                    printf 'Current version: %s%s\n' "$cp" "$current_ver"
                fi
                printf 'New nodes will use %s%s by default.\n' "$cp" "$current_ver"
            else
                printf 'No current version set.\n'
                printf 'Using latest available version automatically.\n'
            fi
            ;;
        show)
            local ver="${1:-}"
            if [ -z "$ver" ]; then
                ver=$(cfg_config_version_latest 2>/dev/null) || ver=""
                [ -z "$ver" ] && { printf 'No config versions found.\n'; return; }
            fi
            cfg_config_version_read "$ver" >/dev/null 2>&1 || {
                printf 'Error: config version "%s" not found\n' "$ver" >&2
                exit 1
            }
            cfg_config_version_info "$ver"
            printf '\nCategories:\n'
            cfg_categories_load "$ver"
            local cat
            for cat in $(cfg_categories_list); do
                if cfg_category_exists "$cat"; then
                    if [ "$cat" = "full" ]; then
                        printf '  %-15s %s\n' "$cat" '(dynamic, all tracked files)'
                    else
                        local count
                        count=$(cfg_category_get_files "$cat" | wc -l)
                        printf '  %-15s %d files\n' "$cat" "$count"
                    fi
                fi
            done
            ;;
        switch)
            local ver="${1:-}"
            [ -z "$ver" ] && { printf 'Usage: dotcfg categories switch <version>\n' >&2; exit 1; }
            cfg_config_version_read "$ver" >/dev/null 2>&1 || {
                printf 'Error: config version "%s" not found\n' "$ver" >&2
                exit 1
            }
            local target_tag
            target_tag=$(cfg_config_get_tag "$ver" 2>/dev/null) || target_tag="stable"
            if [ "$target_tag" = "test" ]; then
                printf 'Switching to test version %s%s. Use with caution.\n' "$(cfg_version_display_prefix "$ver")" "$ver"
            elif [ "$target_tag" = "experimental" ]; then
                printf 'Switching to experimental version %s%s. Use with caution.\n' "$(cfg_version_display_prefix "$ver")" "$ver"
            fi
            local old_ver
            old_ver=$(cfg_config_version_get_current 2>/dev/null) || old_ver=""
            [ -z "$old_ver" ] && old_ver=$(cfg_config_version_latest 2>/dev/null) || true

            if [ -n "$old_ver" ] && [ "$old_ver" != "$ver" ]; then
                local old_p new_p
                old_p=$(cfg_version_display_prefix "$old_ver")
                new_p=$(cfg_version_display_prefix "$ver")
                printf 'Switching from %s%s to %s%s...\n' "$old_p" "$old_ver" "$new_p" "$ver"
                if cfg_nodes_read_index 2>/dev/null && [ ${#_CFG_NODE_CODES[@]} -gt 0 ]; then
                    local found_old=false
                    local i
                    for ((i = 0; i < ${#_CFG_NODE_CODES[@]}; i++)); do
                        if [ "${_CFG_NODE_CONFIG_VERSIONS[$i]:-}" = "$old_ver" ]; then
                            found_old=true
                            break
                        fi
                    done
                    if $found_old; then
                        printf 'Warning: Some nodes use %s%s. They will continue to use %s%s on recovery.\n' "$old_p" "$old_ver" "$old_p" "$old_ver"
                    fi
                fi
            fi

            cfg_config_version_set "$ver"
            local sw_p
            sw_p=$(cfg_version_display_prefix "$ver")
            printf 'Current version set to %s%s.\n' "$sw_p" "$ver"
            printf 'New nodes will use %s%s by default.\n' "$sw_p" "$ver"
            ;;
        remove)
            local ver="${1:-}"
            [ -z "$ver" ] && { printf 'Usage: dotcfg categories remove <version>\n' >&2; exit 1; }
            cfg_config_version_read "$ver" >/dev/null 2>&1 || {
                printf 'Error: config version "%s" not found\n' "$ver" >&2
                exit 1
            }
            local tag version_file
            tag=$(cfg_config_get_tag "$ver" 2>/dev/null) || tag="stable"
            version_file="$DOTFILES_LIB_DIR/categories-${ver}.conf"
            [ -f "$version_file" ] || version_file="$DOTFILES_LIB_DIR/categories-v${ver}.conf"
            if [ "$tag" = "test" ]; then
                printf 'Warning: This is a TEST configuration version (TAG=test).\n' >&2
            elif [ "$tag" = "experimental" ]; then
                printf 'Warning: This is an EXPERIMENTAL configuration version (TAG=experimental).\n' >&2
            fi

            local -a version_nodes=()
            if cfg_nodes_read_index 2>/dev/null; then
                local i
                for ((i = 0; i < ${#_CFG_NODE_CODES[@]}; i++)); do
                    if [ "${_CFG_NODE_CONFIG_VERSIONS[$i]:-}" = "$ver" ]; then
                        version_nodes+=("${_CFG_NODE_CODES[$i]}")
                    fi
                done
            fi
            if [ ${#version_nodes[@]} -gt 0 ]; then
                local nodes_text
                printf -v nodes_text '%s, ' "${version_nodes[@]}"
                nodes_text="${nodes_text%, }"
                printf 'Nodes using this version: %s (%d node%s)\n' \
                    "$nodes_text" "${#version_nodes[@]}" \
                    "$([ ${#version_nodes[@]} -gt 1 ] && printf 's')"
                printf 'Deleting this version may affect these nodes.\n' >&2
            else
                printf 'Nodes using this version: none\n'
            fi
            printf 'Continue? (y/N): '
            local answer
            read -r answer || answer=""
            case "$answer" in
                y|Y|yes|YES) ;;
                *) printf 'Cancelled.\n'; return 0 ;;
            esac
            rm -f -- "$version_file"
            cfg_config_versions_invalidate
            cfg_categories_invalidate
            printf 'Configuration version %s removed: %s\n' "$ver" "$version_file"
            ;;
        *)
            printf 'Usage: dotcfg categories <list|current|show|switch|remove> [args]\n' >&2
            exit 1
            ;;
    esac
}

cmd_switch() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        printf 'Usage: dotcfg switch <full|min|macos|fresh|CODE> [options]\n' >&2
        exit 1
    fi
    shift

    if [[ "$target" =~ ^[a-z0-9]{8}$ ]]; then
        _cmd_switch_to_code "$target" "$@"
        return
    fi

    case "$target" in
        desktop|server)
            target=$(cfg_category_canonical_name "$target")
            ;;
        full|min|macos) ;;
        fresh)
            cfg_nodes_init "$BACKUP_ROOT"
            local root_code=""
            if declare -F fresh_get_root_code >/dev/null 2>&1; then
                root_code=$(fresh_get_root_code 2>/dev/null) || root_code=""
            fi
            if [ -z "$root_code" ]; then
                printf 'Error: root node not found. Run "dotcfg doctor" for details.\n' >&2
                exit 1
            fi
            _cmd_switch_to_code "$root_code" "$@"
            return
            ;;
        *)
            printf 'Error: unknown target "%s"\n' "$target" >&2
            printf 'Valid targets: full, min, macos, fresh, or an 8-char node CODE\n' >&2
            exit 1
            ;;
    esac

    local switch_script="$DOTFILES_LIB_DIR/commands/switch.sh"
    if [ ! -f "$switch_script" ]; then
        printf 'Error: switch script not found at %s\n' "$switch_script" >&2
        exit 1
    fi

    exec bash "$switch_script" --type="$target" "$@"
}

_cmd_switch_to_code() {
    local target_code="$1"
    shift

    cfg_nodes_init "$BACKUP_ROOT"

    if ! cfg_node_exists "$target_code"; then
        printf 'Error: node CODE "%s" not found\n' "$target_code" >&2
        printf 'Run "dotcfg list" to see available nodes.\n' >&2
        exit 1
    fi

    local target_status
    target_status=$(cfg_node_get "$target_code" "status" 2>/dev/null) || target_status="active"
    if [ "$target_status" = "marked_for_removal" ]; then
        printf 'Error: node %s is marked for removal.\n' "$target_code" >&2
        printf 'Run "dotcfg unremove %s" first to restore it.\n' "$target_code" >&2
        exit 1
    fi

    local current_code
    current_code=$(cfg_head_get 2>/dev/null) || true

    if [ "$current_code" = "$target_code" ]; then
        printf 'Already at node %s.\n' "$target_code"
        exit 0
    fi

    local target_type
    target_type=$(cfg_node_get "$target_code" "type")

    printf 'Switching to node %s (%s)...\n' "$target_code" "$target_type"

    local deploy_status
    deploy_status=$(cfg_deploy_status_get)

    if [ "$deploy_status" = "deployed" ] && [ -n "$current_code" ]; then
        printf 'Undeploying current node %s...\n' "$current_code"
        bash "$DOTFILES_LIB_DIR/commands/undeploy.sh" --force "$@" || exit 1
    fi

    cfg_head_set "$target_code"

    if [ "$target_type" != "fresh" ]; then
        printf 'Deploying node %s...\n' "$target_code"
        bash "$DOTFILES_LIB_DIR/commands/deploy.sh" --force "$@" || exit 1
    else
        cfg_deploy_status_set "deployed"
    fi

    printf '\nSwitched to node %s (%s)\n' "$target_code" "$target_type"
}

cmd_validate() {
    cfg_validate "$GIT_DIR"
    cfg_print_validation_result "$GIT_DIR"

    if [ "$CFG_STATE" = "valid" ] && [ "$CFG_IS_OURS" = "true" ]; then
        cfg_check_updates "$GIT_DIR"
        if [ "$CFG_NEEDS_PULL" = "true" ]; then
            printf '  Updates available: yes\n'
        else
            printf '  Updates available: no\n'
        fi
    fi

    local state
    state=$(cfg_detect_state "$GIT_DIR")
    printf '\nInstallation state: %s\n' "$state"
}

cmd_help() {
    printf 'Usage: dotcfg <subcommand> [options]\n'
    printf '\n'
    printf 'Dotfiles state management CLI (node-based)\n'
    printf '\n'
    printf 'Subcommands:\n'
    printf '  status              Show current node and deploy status (default)\n'
    printf '  list                List all nodes (DEPLOY, TYPE, VERSION, STATUS, TIME, CODE)\n'
    printf '  history             Show node tree (git log --graph style)\n'
    printf '  switch <target>     Switch to state (full|min|macos|fresh) or node CODE\n'
    printf '  deploy              Deploy current node configuration\n'
    printf '  undeploy            Undeploy current node, restore original files\n'
    printf '  uninstall           Return to root fresh node\n'
    printf '  migrate             Migrate old backup sessions to node system\n'
    printf '  remove <CODE>       Mark a node for removal\n'
    printf '  unremove <CODE>     Unmark a node from removal\n'
    printf '  autoclean           Permanently delete marked nodes\n'
    printf '  categories          Manage config versions\n'
    printf '  validate            Show detailed repository validation\n'
    printf '  track <file>        Add a file to the fresh root backup\n'
    printf '  untrack <file>      Remove a file from the fresh root backup\n'
    printf '  fresh-status        Show fresh root node backup statistics\n'
    printf '  fresh-diff [path]   Compare $HOME against the fresh root backup\n'
    printf '  fresh-update        Rebuild the fresh root backup from current $HOME\n'
    printf '  fresh-adopt-legacy <path> [--dry-run] [--config-version VERSION]\n'
    printf '                      Reconstruct Fresh from a pre-dotcfg backup\n'
    printf '  doctor              Check system integrity\n'
    printf '  repair              Attempt automatic repairs\n'
    printf '  check-exclude <p>   Show why a path is excluded from fresh backup\n'
    printf '  help                Show this help message\n'
    printf '  version             Show version\n'
    printf '\n'
    printf 'Switch options:\n'
    printf '  --dry-run           Preview changes without applying\n'
    printf '  --force             Force operation (replace existing repos, etc.)\n'
    printf '  --reinstall         Reinstall the current category\n'
    printf '  --auto-stash        Auto-backup conflicting files\n'
    printf '\n'
    printf 'Examples:\n'
    printf '  dotcfg                          # show current status\n'
    printf '  dotcfg list                     # list all nodes\n'
    printf '  dotcfg history                  # show node tree\n'
    printf '  dotcfg switch full              # deploy all managed configuration\n'
    printf '  dotcfg switch min               # deploy command-line configuration\n'
    printf '  dotcfg switch macos             # deploy cross-platform core configuration\n'
    printf '  dotcfg fresh-adopt-legacy ~/.config-backup --dry-run\n'
    printf '  dotcfg switch xk7f9a2m          # switch to historical node\n'
    printf '  dotcfg deploy                   # deploy current node\n'
    printf '  dotcfg undeploy                 # undeploy current node\n'
    printf '  dotcfg uninstall                # return to fresh root node\n'
}

# ── Main dispatch ───────────────────────────────────────────────────────

_lightweight_selfcheck() {
    if [ ! -d "$GIT_DIR" ]; then
        # Repository missing: bootstrap handles first install; otherwise doctor diagnoses
        if [ -d "$BACKUP_ROOT" ]; then
            printf '\xe2\x9a\xa0\xef\xb8\x8f  Repository missing. Run '\''dotcfg doctor'\'' to diagnose.\n' >&2
        fi
        return 0
    fi
    if [ ! -d "$BACKUP_ROOT" ]; then
        printf '\xe2\x9a\xa0\xef\xb8\x8f  Backup directory missing. Run '\''dotcfg doctor'\'' to diagnose.\n' >&2
        return 0
    fi
    local head
    head=$(cfg_head_get 2>/dev/null) || head=""
    if [ -n "$head" ] && ! cfg_node_exists "$head" 2>/dev/null; then
        printf '\xe2\x9a\xa0\xef\xb8\x8f  HEAD points to missing node. Run '\''dotcfg doctor'\'' to diagnose.\n' >&2
        return 0
    fi
    if [ -n "$head" ] && [ ! -d "$BACKUP_ROOT/nodes/fresh_root" ]; then
        local root
        root=$(fresh_get_root_code 2>/dev/null) || root=""
        if [ -z "$root" ]; then
            printf '\xe2\x9a\xa0\xef\xb8\x8f  Root node missing. Run '\''dotcfg doctor'\'' to diagnose.\n' >&2
        fi
    fi
}

subcmd="${1:-status}"
shift || true

load_business=true
case "$subcmd" in
	help|-h|--help|version|--version) load_business=false ;;
esac
if $load_business; then
	for arg in "$@"; do
		case "$arg" in
			-h|--help) load_business=false; break ;;
		esac
	done
fi
$load_business && _dotcfg_load_business_libraries

for arg in "$@"; do
    case "$arg" in
        -h|--help) cmd_help; exit 0 ;;
    esac
done

case "$subcmd" in
    help|-h|--help|version|--version|migrate|doctor|repair|check-exclude|fresh-adopt-legacy) ;;
    *)
        cfg_nodes_init "$BACKUP_ROOT"
        if cfg_nodes_needs_migration "$BACKUP_ROOT"; then
            printf 'Old backup sessions detected. Running migration...\n\n'
            bash "$DOTFILES_LIB_DIR/commands/migrate.sh" || {
                printf 'Migration failed. Run "dotcfg migrate" manually.\n' >&2
                exit 1
            }
            printf '\n'
        fi
        _lightweight_selfcheck
        ;;
esac

case "$subcmd" in
    status)   cmd_status "$@" ;;
    list)     cmd_list "$@" ;;
    history)  cmd_history "$@" ;;
    switch)   cmd_switch "$@" ;;
    deploy)   exec bash "$DOTFILES_LIB_DIR/commands/deploy.sh" "$@" ;;
    undeploy) exec bash "$DOTFILES_LIB_DIR/commands/undeploy.sh" "$@" ;;
    uninstall) exec bash "$DOTFILES_LIB_DIR/commands/uninstall.sh" "$@" ;;
    migrate)  exec bash "$DOTFILES_LIB_DIR/commands/migrate.sh" "$@" ;;
    remove)   exec bash "$DOTFILES_LIB_DIR/commands/remove.sh" "$@" ;;
    unremove) exec bash "$DOTFILES_LIB_DIR/commands/unremove.sh" "$@" ;;
    autoclean) exec bash "$DOTFILES_LIB_DIR/commands/autoclean.sh" "$@" ;;
    track)    exec bash "$DOTFILES_LIB_DIR/commands/track.sh" "$@" ;;
    untrack)  exec bash "$DOTFILES_LIB_DIR/commands/untrack.sh" "$@" ;;
    fresh-status) exec bash "$DOTFILES_LIB_DIR/commands/fresh-status.sh" "$@" ;;
    fresh-diff)   exec bash "$DOTFILES_LIB_DIR/commands/fresh-diff.sh" "$@" ;;
    fresh-update) exec bash "$DOTFILES_LIB_DIR/commands/fresh-update.sh" "$@" ;;
    fresh-adopt-legacy) fresh_adopt_legacy "$@" ;;
    doctor)   exec bash "$DOTFILES_LIB_DIR/commands/doctor.sh" "$@" ;;
    repair)   exec bash "$DOTFILES_LIB_DIR/commands/repair.sh" "$@" ;;
    check-exclude) exec bash "$DOTFILES_LIB_DIR/commands/check-exclude.sh" "$@" ;;
    categories) cmd_categories "$@" ;;
    validate) cmd_validate "$@" ;;
    help|-h|--help) cmd_help ;;
    version|--version) printf 'dotcfg %s\n' "$DOTCFG_VERSION" ;;
    *)
        printf 'Unknown subcommand: %s\n' "$subcmd" >&2
        printf '\n' >&2
        cmd_help >&2
        exit 1
        ;;
esac
