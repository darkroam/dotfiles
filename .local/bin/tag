#!/bin/sh

err() { echo "Usage:
	tag [OPTIONS] file
Options:
	-a: artist/author
	-t: song/chapter title
	-A: album/book title
	-n: track/chapter number
	-N: total number of tracks/chapters
	-d: year of publication
	-g: genre
	-c: comment
You will be prompted for title, artist, album and track if not given." && exit 1 ;}

while getopts "a:t:A:n:N:d:g:c:f:" o; do case "${o}" in
	a) artist="${OPTARG}" ;;
	t) title="${OPTARG}" ;;
	A) album="${OPTARG}" ;;
	n) track="${OPTARG}" ;;
	N) total="${OPTARG}" ;;
	d) date="${OPTARG}" ;;
	g) genre="${OPTARG}" ;;
	c) comment="${OPTARG}" ;;
	f) file="${OPTARG}" ;;
	*) printf "Invalid option: -%s\\n" "$OPTARG" && err ;;
esac done

shift $((OPTIND - 1))

file="${file:-$1}"

[ ! -f "$file" ] && echo "Provide file to tag." && err

case "$file" in
	*.ogg)  command -v vorbiscomment >/dev/null 2>&1 || { printf '%s\n' "vorbiscomment not installed" >&2; exit 1; } ;;
	*.opus) command -v opustags >/dev/null 2>&1 || { printf '%s\n' "opustags not installed" >&2; exit 1; } ;;
	*.mp3)  command -v eyeD3 >/dev/null 2>&1 || { printf '%s\n' "eyeD3 not installed" >&2; exit 1; } ;;
	*.flac) command -v metaflac >/dev/null 2>&1 || { printf '%s\n' "metaflac not installed" >&2; exit 1; } ;;
esac

[ -z "$title" ] && echo "Enter a title." && read -r title
[ -z "$artist" ] && echo "Enter an artist." && read -r artist
[ -z "$album" ] && echo "Enter an album." && read -r album
[ -z "$track" ] && echo "Enter a track number." && read -r track

case "$file" in
	*.ogg)
		tags="Title=$title
Artist=$artist
Album=$album
Track=$track"
		[ -n "$total" ] && tags="$tags
Total=$total"
		[ -n "$date" ] && tags="$tags
Date=$date"
		[ -n "$genre" ] && tags="$tags
Genre=$genre"
		[ -n "$comment" ] && tags="$tags
Comment=$comment"
		printf '%s\n' "$tags" | vorbiscomment -w "$file" ;;
	*.opus)
		tags="Title=$title
Artist=$artist
Album=$album
Track=$track"
		[ -n "$total" ] && tags="$tags
Total=$total"
		[ -n "$date" ] && tags="$tags
Date=$date"
		[ -n "$genre" ] && tags="$tags
Genre=$genre"
		[ -n "$comment" ] && tags="$tags
Comment=$comment"
		printf '%s\n' "$tags" | opustags -i -S "$file" ;;
	*.mp3)
		eyeD3 -Q --remove-all -a "$artist" -A "$album" -t "$title" -n "$track" "$file"
		[ -n "$total" ] && eyeD3 -Q -N "$total" "$file"
		[ -n "$date" ] && eyeD3 -Q -Y "$date" "$file"
		;;
	*.flac)
		tags="TITLE=$title
ARTIST=$artist
ALBUM=$album
TRACKNUMBER=$track"
		[ -n "$total" ] && tags="$tags
TOTALTRACKS=$total"
		[ -n "$date" ] && tags="$tags
DATE=$date"
		[ -n "$genre" ] && tags="$tags
GENRE=$genre"
		[ -n "$comment" ] && tags="$tags
DESCRIPTION=$comment"
		printf '%s\n' "$tags" | metaflac --remove-all-tags --import-tags-from=- "$file" ;;
	*) echo "File type not implemented yet." ;;
esac
