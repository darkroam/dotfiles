# Match ~/src/st/config.h. Ghostty sizes are points. At Xft.dpi 96,
# 10.5pt is 14px. Padding only accepts whole points; 2pt rounds to 2px.
font-family = monospace
font-size = 10.5
background = #282828
foreground = #ebdbb2
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2
background-opacity = 0.8
cursor-style = block
cursor-color = #add8e6
cursor-text = #555555
shell-integration-features = no-cursor
term = st-256color
window-padding-x = 2
window-padding-y = 2
window-decoration = false
window-width = 80
window-height = 24
