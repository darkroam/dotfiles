#!/bin/sh

# ============================================================================
# EDITOR & SHELL BASICS
# ============================================================================

# Use neovim for vim if present.
[ -x "$(command -v nvim)" ] && alias vim="nvim" vimdiff="nvim -d"
alias nvim="$EDITOR"

# Use $XINITRC variable if file exists.
[ -f "$XINITRC" ] && alias startx="startx $XINITRC"

# ============================================================================
# SUDO WRAPPERS
# ============================================================================

# Run selected system commands through sudo when they are available. Login
# shells do not always include sbin directories in PATH, so check them directly.
for command in mount umount sv pacman apt updatedb su shutdown poweroff reboot ; do
	command_path=""
	for command_dir in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
		if [ -x "$command_dir/$command" ] && [ ! -d "$command_dir/$command" ]; then
			command_path="$command_dir/$command"
			break
		fi
	done
	[ -n "$command_path" ] && alias "$command=sudo $command_path"
done
unset command command_path command_dir

# ============================================================================
# CORE COMMANDS
# ============================================================================

# Verbosity and settings that you pretty much just always are going to want.
alias \
	batt="cat /sys/class/power_supply/BAT?/capacity" \
	cp="cp -iv" \
	mv="mv -iv" \
	rm="rm -vI" \
	bc="bc -ql" \
	mkd="mkdir -pv" \
	yt="yt-dlp --embed-metadata -i" \
	yta="yt -x -f bestaudio/best" \
	ffmpeg="ffmpeg -hide_banner"

# ============================================================================
# OS-SPECIFIC SETTINGS
# ============================================================================

# Colorize commands when possible.
if [ "$(uname)" = "Darwin" ]; then
	alias \
		ls="ls -h" \
		sl="ls -h" \
		l.='ls -d .*' \
		ll='ls -hAlF' \
		ll.='ls -hAlFd .*'
elif [ "$(uname -s)" = "Linux" ]; then
	alias \
		ls="ls -hN --color=auto --group-directories-first" \
		sl="ls -hN --color=auto --group-directories-first" \
		l.='ls -d .* --color=auto --group-directories-first' \
		ll='ls -hAlF --group-directories-first' \
		ll.='ls -hAlFd .* --group-directories-first' \
		diff="diff --color=auto"
fi

# ============================================================================
# NAVIGATION & COLORIZE
# ============================================================================

alias \
	grep="grep --color=auto" \
	ccat="highlight --out-format=ansi" \
	ip="ip -color=auto" \
	which='command -v' \
	..='cd ..' \
	...='cd ../..'

pss() { ps aux | grep -v grep | grep -i -e VSZ -e "${1:-.}"; }

# ============================================================================
# ABBREVIATIONS
# ============================================================================

# These common commands are just too long! Abbreviate them.
alias \
	ka="killall" \
	g="git" \
	gua='git remote | xargs -L1 git push --all' \
	c='/usr/bin/git --git-dir=$HOME/.cfg/ --work-tree=$HOME' \
	trem="transmission-remote" \
	YT="youtube-viewer" \
	sdn="sudo shutdown -h now" \
	e="emacs" \
	v="$EDITOR" \
	calcurse='calcurse -D ~/.config/calcurse'

# ============================================================================
# GIT HELPERS
# ============================================================================

# Shared Git helpers. Keep gs for the system Ghostscript command.
alias \
	gco='git checkout' \
	gd='git --no-pager diff' \
	gst='git --no-pager status' \
	gss='git --no-pager status -s' \
	gsh='git --no-pager show' \
	gpt='git push origin --tags'

unalias gam 2>/dev/null || true

gpo() {
	local branch
	branch=$(git symbolic-ref --short -q HEAD) || return 1
	git push origin "$branch"
}

gpl() {
	local branch
	branch=$(git symbolic-ref --short -q HEAD) || return 1
	git pull origin "$branch" --ff-only
}

glt() {
	git tag -n --sort=taggerdate | tail -n "${1:-10}"
}

gat() {
	[ "$#" -eq 2 ] || return 2
	git tag -a "$1" -m "$2"
}

gam() {
	git add --all && git commit -m "$*"
}

gitlog() {
	[ -n "${1:-}" ] || return 2
	git --no-pager log --date=format:'%Y-%m-%d %H:%M' --pretty="tformat:$1" --graph -n "${2:-10}"
}

gll() {
	gitlog "%C(${gitHashColor:-magenta})%h %C(${gitContentColor:-cyan})%s%Creset" "${1:-10}"
}

glll() {
	gitlog "%C(${gitHashColor:-magenta})%h %C(${gitDateColor:-yellow})%cd %C(${gitAuthorColor:-blue})%cn: %C(${gitContentColor:-cyan})%s%Creset" "${1:-10}"
}

# ============================================================================
# CONFIG REPO HELPERS
# ============================================================================

# Mirror the Git helpers above for the bare configuration repository.
cfg_git() {
	/usr/bin/git --git-dir="$HOME/.cfg/" --work-tree="$HOME" "$@"
}

cgco() {
	cfg_git checkout "$@"
}

cgpo() {
	local branch
	branch=$(cfg_git symbolic-ref --short -q HEAD) || return 1
	cfg_git push origin "$branch"
}

cgpl() {
	local branch
	branch=$(cfg_git symbolic-ref --short -q HEAD) || return 1
	cfg_git pull origin "$branch" --ff-only
}

cgd() {
	cfg_git --no-pager diff "$@"
}

cgst() {
	cfg_git --no-pager status "$@"
}

cgss() {
	cfg_git --no-pager status -s "$@"
}

cgsh() {
	cfg_git --no-pager show "$@"
}

cgpt() {
	cfg_git push origin --tags "$@"
}

cglt() {
	cfg_git tag -n --sort=taggerdate | tail -n "${1:-10}"
}

cgat() {
	[ "$#" -eq 2 ] || return 2
	cfg_git tag -a "$1" -m "$2"
}

cgam() {
	cfg_git add --all && cfg_git commit -m "$*"
}

cgitlog() {
	[ -n "${1:-}" ] || return 2
	cfg_git --no-pager log --date=format:'%Y-%m-%d %H:%M' --pretty="tformat:$1" --graph -n "${2:-10}"
}

cgll() {
	cgitlog "%C(${gitHashColor:-magenta})%h %C(${gitContentColor:-cyan})%s%Creset" "${1:-10}"
}

cglll() {
	cgitlog "%C(${gitHashColor:-magenta})%h %C(${gitDateColor:-yellow})%cd %C(${gitAuthorColor:-blue})%cn: %C(${gitContentColor:-cyan})%s%Creset" "${1:-10}"
}

# ============================================================================
# PROXY CONTROLS
# ============================================================================

# Shared proxy controls for Bash and Zsh. They only change the current shell.
setproxy() {
	export http_proxy='http://127.0.0.1:7897'
	export https_proxy='http://127.0.0.1:7897'
	export all_proxy='socks5://127.0.0.1:7897'
	export HTTP_PROXY="$http_proxy"
	export HTTPS_PROXY="$https_proxy"
	export ALL_PROXY="$all_proxy"
}

unsetproxy() {
	unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
}

git_set_proxy() {
	git config --global http.proxy 'http://127.0.0.1:7897'
	git config --global https.proxy 'http://127.0.0.1:7897'
}

git_unset_proxy() {
	git config --global --unset http.proxy
	git config --global --unset https.proxy
}

# ============================================================================
# PACKAGE MANAGEMENT
# ============================================================================

# All aliases use the same pm-prefix across distributions.  The old p-prefix
# is deliberately removed because pi is also a standalone command.
unalias p pu pi pr pse pp pl pc pms 2>/dev/null || true
# pm: manager, pmu: update, pmi: install, pmr: remove, pms: search,
# pmp: package information, pml: installed packages, pmc: cleanup.
if command -v apt >/dev/null 2>&1; then
	alias pm='sudo apt'
	alias pmu='sudo apt update && sudo apt upgrade'
	alias pmi='sudo apt install'
	alias pmr='sudo apt remove'
	alias pms='apt search'
	alias pmp='apt show'
	alias pml='apt list --installed'
	alias pmc='sudo apt autoremove --purge'
elif command -v pacman >/dev/null 2>&1; then
	alias pm='sudo pacman'
	alias pmu='sudo pacman -Syu'
	alias pmi='sudo pacman -S'
	alias pmr='sudo pacman -Rns'
	alias pms='pacman -Ss'
	alias pmp='pacman -Qi'
	alias pml='pacman -Q'
	alias pmc='pacman -Qtdq | xargs -r sudo pacman -Rns'
elif command -v xbps-install >/dev/null 2>&1; then
	alias pm='sudo xbps-install'
	alias pmu='sudo xbps-install -Syu'
	alias pmi='sudo xbps-install'
	alias pmr='sudo xbps-remove -R'
	alias pms='xbps-query -Rs'
	alias pmp='xbps-query -R'
	alias pml='xbps-query -l'
	alias pmc='sudo xbps-remove -Oo'
elif command -v emerge >/dev/null 2>&1; then
	alias pm='sudo emerge'
	alias pmu='sudo emerge-webrsync && sudo emerge --ask -uDN @world'
	alias pmi='sudo emerge'
	alias pmr='sudo emerge --ask --unmerge'
	alias pms='emerge --search'
	alias pmp='emerge -pv'
	alias pml='find /var/db/pkg -mindepth 2 -maxdepth 2 -type d -printf "%P\n"'
	alias pmc='sudo emerge --depclean'
fi

# ============================================================================
# MEDIA & APPS
# ============================================================================

# Give each MPV instance a unique socket so pauseallmpv can control it.
mpv() {
	mpv_socket_dir="${XDG_RUNTIME_DIR:-/tmp}/mpvSockets"
	if ! mkdir -p "$mpv_socket_dir"; then
		unset mpv_socket_dir
		return 1
	fi
	command mpv --input-ipc-server="$mpv_socket_dir/mpv-$$-$(date +%s%N)" "$@"
	mpv_status=$?
	unset mpv_socket_dir
	return "$mpv_status"
}

alias \
	lf="lfub" \
	magit="nvim -c MagitOnly" \
	ref="shortcuts >/dev/null; source ${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutrc ; source ${XDG_CONFIG_HOME:-$HOME/.config}/shell/zshnameddirrc" \
	lg="lazygit" \
	t="tldr" \
	cc-switch-cli='~/.local/bin/cc-switch'

# ============================================================================
# LOCAL OVERRIDES
# ============================================================================

local_aliasrc="${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc.local"
[ -r "$local_aliasrc" ] && . "$local_aliasrc"
unset local_aliasrc
