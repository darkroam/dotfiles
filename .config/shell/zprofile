#!/bin/zsh

# Load the shell-independent environment used by login shells.
. "$HOME/.config/shell/profile"

unsetopt PROMPT_SP

# Start the graphical session only from the local first console.
if [[ $(tty) == /dev/tty1 ]] && [ -z "$SSH_CONNECTION" ] && [ -z "$DISPLAY" ]; then
    graphics_devices=(/dev/dri/card<->(N) /dev/fb<->(N))
    if (( ${#graphics_devices} )) && ! pgrep -x Xorg >/dev/null 2>&1; then
        export XINITRC="${XDG_CONFIG_HOME:-$HOME/.config}/x11/xinitrc"
        exec startx
    fi
    unset graphics_devices
fi

# TTY login sessions inherit the generated system locale through PAM.
# Do not override LANG or LC_ALL here: an unavailable locale breaks fbterm,
# Perl, and manpath before the shell can be used for recovery.

# fbterm is validated on the current driver. The optional map below swaps Esc
# and Caps Lock in TTY/fbterm; unlike X11 xcape, it cannot distinguish a tap
# from a held modifier. Keep it disabled because loadkeys is privileged and an
# automatic noninteractive sudo failure generates a mail_badpass notice.
# Run this manually after boot when the fixed TTY mapping is needed:
# sudo loadkeys "${XDG_DATA_HOME:-$HOME/.local/share}/larbs/ttymaps.kmap"

# Open validated framebuffer terminals on local recovery consoles. Keep the
# login shell as a fallback if fbterm exits or cannot start.
if [[ $(tty) == /dev/tty[2-9] ]] && [ -z "$SSH_CONNECTION" ] && [ -z "$DISPLAY" ] &&
    command -v fbterm >/dev/null 2>&1; then
    fbterm || print -u2 -- "fbterm failed; continuing in the login shell."
fi
