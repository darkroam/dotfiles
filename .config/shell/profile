#!/bin/sh

# profile file. Runs on login. Environmental variables are set here.

# If you don't plan on reverting to bash, you can remove the link in ~/.profile
# to clean up.

# PATH
local_bin="$HOME/.local/bin"
case ":$PATH:" in
	*:"$local_bin":*) ;;
	*) PATH="$local_bin:$PATH" ;;
esac
local_bin_paths=$(find "$local_bin" -mindepth 1 -type d ! -name __pycache__ -exec printf '%s:' {} + 2>/dev/null)
local_bin_paths=${local_bin_paths%:}
[ -n "$local_bin_paths" ] && PATH="$PATH:$local_bin_paths"
export PATH
unset local_bin local_bin_paths

# Window manager
export LARBSWM="dwm"

# Default programs
export EDITOR="nvim"
export TERMINAL="st"
export BROWSER="microsoft-edge"
export READER="zathura"
export FILE="lfub"
export STATUSBAR="${LARBSWM}blocks"

# XDG Base Directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Program config paths
#export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
#export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority" # This line will break some DMs.
export NOTMUCH_CONFIG="$XDG_CONFIG_HOME/notmuch-config"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc-2.0"
export LESSHISTFILE="-"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
# disabled: ALSA_CONFIG_PATH replaces system alsa.conf and breaks PipeWire
# export ALSA_CONFIG_PATH="$XDG_CONFIG_HOME/alsa/asoundrc"
#export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export WINEPREFIX="$XDG_DATA_HOME/wineprefixes/default"
export KODI_DATA="$XDG_DATA_HOME/kodi"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export ANSIBLE_CONFIG="$XDG_CONFIG_HOME/ansible/ansible.cfg"
export UNISON="$XDG_DATA_HOME/unison"
export HISTFILE="$XDG_DATA_HOME/history"
export WEECHAT_HOME="$XDG_CONFIG_HOME/weechat"
export MBSYNCRC="$XDG_CONFIG_HOME/mbsync/config"
export ELECTRUMDIR="$XDG_DATA_HOME/electrum"

# Go
export GOPATH="$XDG_DATA_HOME/go"
export GO111MODULE=on
export GOPROXY=https://goproxy.cn,direct

# Other settings
export DICS="/usr/share/stardict/dic/"
export SUDO_ASKPASS="$HOME/.local/bin/dmenupass"
export FZF_DEFAULT_OPTS="--layout=reverse --height 40%"
export GIT_TERMINAL_PROMPT=1
export LESS=-R
export TMUX_TMPDIR="$XDG_RUNTIME_DIR"
# Man page colors
export LESS_TERMCAP_mb="$(printf '%b' '[1;31m')"
export LESS_TERMCAP_md="$(printf '%b' '[1;36m')"
export LESS_TERMCAP_me="$(printf '%b' '[0m')"
export LESS_TERMCAP_so="$(printf '%b' '[01;44;33m')"
export LESS_TERMCAP_se="$(printf '%b' '[0m')"
export LESS_TERMCAP_us="$(printf '%b' '[1;32m')"
export LESS_TERMCAP_ue="$(printf '%b' '[0m')"
export LESSOPEN="| /usr/bin/highlight -O ansi %s 2>/dev/null"
export QT_QPA_PLATFORMTHEME="gtk3"	# Use the installed GTK platform theme for Qt applications.
export MOZ_USE_XINPUT2="1"		# Mozilla smooth scrolling/touchpads.
export _JAVA_AWT_WM_NONREPARENTING=1	# Fix for Java applications in dwm

# User overrides
profile_local="$XDG_CONFIG_HOME/shell/profile.local"
[ -r "$profile_local" ] && . "$profile_local"
unset profile_local

# Shell shortcuts
shell_shortcuts="$XDG_CONFIG_HOME/shell/shortcutrc"
zsh_named_dirs="$XDG_CONFIG_HOME/shell/zshnameddirrc"
lf_shortcuts="$XDG_CONFIG_HOME/lf/shortcutrc"
if [ ! -f "$shell_shortcuts" ] || [ ! -f "$zsh_named_dirs" ] || [ ! -f "$lf_shortcuts" ]; then
	"$HOME/.local/bin/shortcuts" >/dev/null 2>&1
fi
unset shell_shortcuts zsh_named_dirs lf_shortcuts
