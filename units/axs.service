[Unit]
Description=axs mihomo
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p %h/.local/lib/access/run
# health 只认 mihomo.pid。exec 后这个 pid 就是 mihomo。
ExecStart=/bin/sh -c 'echo $$ > %h/.local/lib/access/run/mihomo.pid; exec %h/.local/bin/mihomo -d %h/.local/lib/access/run'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
