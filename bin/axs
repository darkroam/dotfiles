#!/bin/sh
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC1091
. "$ROOT/lib/common.sh"

usage() {
    say_err "用法：axs start|stop|status|restart|ensure|clean"
    say_err "      axs service enable|disable"
    say_err "      axs sub get|refresh|clean"
    say_err "      axs rule list|add|del"
    say_err "      axs node groups|list|test|switch"
    say_err "      axs net test"
    exit 1
}

cmd=${1:-}
if [ $# -gt 0 ]; then shift; fi
case $cmd in
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    status) cmd_status "$@" ;;
    health) cmd_health "$@" ;;
    ensure) cmd_ensure "$@" ;;
    clean) cmd_clean "$@" ;;
    service)
        sub=${1:-}
        if [ $# -gt 0 ]; then shift; fi
        case $sub in
            enable|disable)
                [ $# -eq 0 ] || die 1 "用法"
                cmd_service_boot "$sub"
                ;;
            *) usage ;;
        esac
        ;;
    sub)
        sub=${1:-}
        if [ $# -gt 0 ]; then shift; fi
        case $sub in
            get) cmd_sub_get "$@" ;;
            refresh) cmd_refresh "$@" ;;
            clean) cmd_sub_clean "$@" ;;
            *) usage ;;
        esac
        ;;
    rule)
        sub=${1:-}
        if [ $# -gt 0 ]; then shift; fi
        case $sub in
            list) cmd_rule_list "$@" ;;
            add) cmd_rule_add "$@" ;;
            del) cmd_rule_del "$@" ;;
            *) usage ;;
        esac
        ;;
    node)
        sub=${1:-}
        if [ $# -gt 0 ]; then shift; fi
        case $sub in
            groups) cmd_groups "$@" ;;
            list) cmd_node_list "$@" ;;
            test) cmd_test "$@" ;;
            switch) cmd_switch "$@" ;;
            *) usage ;;
        esac
        ;;
    net)
        sub=${1:-}
        if [ $# -gt 0 ]; then shift; fi
        case $sub in
            test) cmd_net "$@" ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
